# Copy to .env.local for local work. In Vercel, add these under Project > Settings > Environment Variables.

# Google Apps Script web app (server only, never exposed to the browser)
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Meta Pixel (browser) and Conversions API (server)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: send CAPI events to Meta's Test Events tab while testing
META_TEST_EVENT_CODE=

# Google Analytics 4 measurement ID, like G-XXXXXXX
NEXT_PUBLIC_GA_ID=

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://beoutlier.in

# Hackathon payment page (Razorpay, Cashfree or any gateway payment link).
# After booking, the parent is sent here. Leave empty until the gateway is ready.
NEXT_PUBLIC_HACKATHON_PAYMENT_URL=
